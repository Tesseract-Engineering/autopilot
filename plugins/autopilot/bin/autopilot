#!/usr/bin/env bash
# autopilot: one entry point for the core scripts (on PATH in Claude via the plugin's bin/).
# Agents use this. Humans may also call scripts/ directly, e.g. to reset an attempt cap.
set -uo pipefail
S="$(cd "$(dirname "$0")/../scripts" && pwd)"
cmd="${1:-help}"; shift || true
cur() { "$S/run.sh" current 2>/dev/null; }
case "$cmd" in
  init)            exec "$S/init.sh" "$@" ;;
  install-git)     exec "$S/install-git.sh" "$@" ;;
  repo-gate)       exec "$S/repo-gate.sh" "$@" ;;
  start)           exec "$S/run.sh" start "$@" ;;
  current)         exec "$S/run.sh" current ;;
  status)          r="${1:-$(cur)}"; [ -n "$r" ] || { echo "no active run"; exit 1; }; exec "$S/run.sh" status "$r" ;;
  phase|tests-done|commit|end|get) exec "$S/run.sh" "$cmd" "$@" ;;
  rundir)          r="${1:-$(cur)}"; . "$S/lib/common.sh"; need_run "$r"; run_dir "$r" ;;
  diff)            r="${1:-$(cur)}"; . "$S/lib/common.sh"; need_run "$r"
                   out="$(run_dir "$r")/diff.patch"
                   git -C "$AP_MAIN" diff "$(state_get "$r" impl_base)" > "$out"
                   git -C "$AP_MAIN" diff --stat "$(state_get "$r" impl_base)" >&2
                   echo "$out" ;;
  plan-check)      exec "$S/plan-check.sh" "$@" ;;
  worktree)        exec "$S/worktree.sh" "$@" ;;
  merge)           exec "$S/merge.sh" "$@" ;;
  pick)            exec "$S/pick.sh" "$@" ;;
  gate)            exec "$S/gate.sh" "$@" ;;
  red-check)       exec "$S/red-check.sh" "$@" ;;
  verify-finding)  exec "$S/verify-finding.sh" "$@" ;;
  attempts)        [ $# -eq 2 ] || { echo "usage: autopilot attempts RUN UNIT" >&2; exit 64; }
                   echo "$("$S/attempts.sh" status "$1" "$2") $("$S/attempts.sh" count "$1" "$2")" ;;
  help|-h|--help)
    cat <<'H'
autopilot <command>
  init                         scaffold the per-repo contract (idempotent)
  install-git [--ci]           pre-push hook (+ CI workflow) running .autopilot/repo-gate.sh
  repo-gate [BASE]             harness-free gate: checks + protected paths on autopilot/* branches
  start PATTERN "TASK"         small|default|fan-out|best-of-n|bug-fix -> prints RUN id
  current | status [RUN] | get RUN [KEY] | rundir [RUN]
  phase RUN PHASE              plan|plan_review|tests|implement|review|final
  plan-check RUN               validate slices.json
  red-check RUN                test-writer verdict (tests fail, only tests changed)
  tests-done RUN               commit tests, set impl_base, snapshot test hashes
  worktree RUN SLICE           worktree from impl_base (+.worktreeinclude, setup.sh)
  gate RUN UNIT                verdict for a slice or "integration" (0 pass/1 fail/3 escalated)
  merge RUN [SLICE...]         deterministic merge of passed slices
  pick RUN [SLICE...]          best-of-N: passing, then smallest diff
  diff [RUN]                   write the run diff to RUN_DIR/diff.patch
  verify-finding RUN FILE      keep a reviewer finding only if its repro fails
  commit RUN MSG | end RUN done|aborted|escalated
  attempts RUN UNIT            show status and count (read-only)
H
    ;;
  *) echo "autopilot: unknown command '$cmd' (try: autopilot help)" >&2; exit 64 ;;
esac
